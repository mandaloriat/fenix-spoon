  "series_limits": {
    "$comment": "The series ceilings, mirrored in fenixspoon/series.py and in the SDK's validate.ts. Both conformance suites assert their own constants against these, so lowering a limit on one side without the other fails on the other \u2014 the same mechanism protocol_version uses in version.json. The numbers are here rather than as an over-ceiling payload because a 4096-element array in a corpus whose grids are deliberately tiny would be eight thousand unreadable lines.",
    "max_points_per_trace": 4096,
    "max_traces_per_series": 32,
    "max_series_per_result": 32,
    "max_total_points": 8192
  }
