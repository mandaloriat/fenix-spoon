{
  "name": "@fenix-spoon/client",
  "version": "0.1.0",
  "description": "Typed client for the Fenix Spoon wire protocol: solvers, jobs, progress streams, results",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/ws": "^8.18.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "ws": "^8.21.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mandaloriat/fenix-spoon.git",
    "directory": "client/packages/client"
  }
}
